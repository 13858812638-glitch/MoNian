+// A single, stateless exit path for mutually exclusive facet Picker modes.
+// The caller determines the activation order: the folder sort Picker has
+// always exited maintenance before selection, unlike tag/property sorting.
+// Keep the original setActive calls (and their existing refresh semantics).
+export function deactivateConflictingFacetPickerModes({
+    selectionMode = null,
+    maintenanceMode = null,
+    sortToggle = null,
+    maintenanceFirst = true
+} = {}) {
+    if (maintenanceFirst) maintenanceMode?.setActive("");
+    selectionMode?.setActive(false);
+    if (!maintenanceFirst) maintenanceMode?.setActive("");
+    sortToggle?.setActive(false);
+}
